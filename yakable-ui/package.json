{
  "name": "yakable-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src vite.config.ts vitest.config.ts --deny-warnings",
    "lint:fix": "oxlint src vite.config.ts vitest.config.ts --fix",
    "format": "oxfmt src vite.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src vite.config.ts vitest.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@streamdown/code": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "streamdown": "^2.6.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "happy-dom": "20.14.5",
    "vitest": "4.1.11",
    "@testing-library/user-event": "14.6.7"
  }
}

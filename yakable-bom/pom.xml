<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>io.yakable</groupId>
    <artifactId>yakable-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Yakable BOM</name>
    <description>Yakable dependency alignment</description>

    <properties>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-plugin-model-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-plugin-model-openai-compatible</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-plugin-model-deepseek</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-plugin-model-all</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-dao</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.yakable</groupId>
                <artifactId>yakable-boot</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
